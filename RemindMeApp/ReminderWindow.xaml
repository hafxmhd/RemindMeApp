<Window x:Class="RemindMeApp.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemindMe"
        Width="460"
        Height="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="ReminderWindow_Loaded">

    <Border Background="#F7F7FF"
            BorderBrush="#DADCFD"
            BorderThickness="1"
            CornerRadius="20"
            Padding="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Friend.png"
                       Width="145"
                       Height="225"
                       Stretch="Uniform"
                       VerticalAlignment="Bottom"/>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">

                    <TextBlock Text="Hey buddy! 👋"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#686FF6"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TaskTitleText"
                               Text="It's time for your task!"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="#252B40"/>

                    <TextBlock x:Name="TaskDescriptionText"
                               FontSize="13"
                               Foreground="#788198"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">

                <Button Content="Done"
                        Width="90"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="DoneButton_Click"/>

                <Button Content="Snooze 5 min"
                        Width="115"
                        Height="36"
                        Click="SnoozeButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
