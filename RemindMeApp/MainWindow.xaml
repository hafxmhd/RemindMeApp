<Window x:Class="RemindMeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemindMe - Task Manager"
        Height="720" Width="900"
        MinHeight="650" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FA">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="RemindMe"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#252B40"/>

            <TextBlock Text="Your personal task companion"
                       FontSize="14"
                       Foreground="#788198"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Task creation form -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="24"
                Margin="0,0,0,22">

            <StackPanel>
                <TextBlock Text="Create a new task"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#252B40"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Task title"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="TaskTitleBox"
                         Height="38"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Description (optional)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="TaskDescriptionBox"
                         Height="60"
                         FontSize="14"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reminder date"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <DatePicker x:Name="TaskDatePicker"
                                    Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reminder time (24-hour)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="TaskTimeBox"
                                 Height="36"
                                 Padding="8"
                                 Text="15:00"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Clear"
                            Width="100"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="ClearButton_Click"/>

                    <Button Content="Save Task"
                            Width="130"
                            Height="40"
                            Background="#686FF6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="SaveTaskButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Saved task list -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="22">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Your tasks"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#252B40"
                           Margin="0,0,0,16"/>

                <ListBox x:Name="TasksListBox"
                         BorderThickness="0"
                         Background="White"
                         FontSize="14"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
